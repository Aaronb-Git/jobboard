# Configuration locale de développement. Copie ce fichier sous le nom .env.
MARIADB_DATABASE=job_board
MARIADB_USER=job_board_user
MARIADB_PASSWORD=dev_password_change_me
MARIADB_ROOT_PASSWORD=dev_root_password_change_me
SESSION_SECRET=docker compose exec backend node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"